# Required
ANTHROPIC_API_KEY=sk-ant-...
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# CORS — set to your Vercel domain (comma-separated for multiple)
ALLOWED_ORIGINS=https://yourdomain.com

# Strongly recommended before going live — without these, /api/order,
# /api/execute, /api/withdraw, /api/parse, /api/ask are unauthenticated.
# Get both from dashboard.privy.io → your app → Settings → Basics.
# PRIVY_APP_ID must match the web app's VITE_PRIVY_APP_ID.
# PRIVY_APP_ID=your-privy-app-id
# PRIVY_APP_SECRET=your-privy-app-secret

# Optional — co-signs every swap so users don't need SOL for gas
# SPONSOR_PRIVATE_KEY=base58encodedprivatekey

# Optional — max SOL/day the sponsor wallet will give away in gas top-ups (default 1)
# SPONSOR_DAILY_SOL_CAP=1

# Optional — per-IP rate limits, requests/minute (defaults shown)
# RATE_LIMIT_ORDER=20
# RATE_LIMIT_PARSE=10

# Optional — reject a swap if Jupiter reports price impact above this, in percent (default 5)
# MAX_PRICE_IMPACT_PCT=5

# Optional — comma-separated Solana addresses that may skip the perps geo-gate
# for internal QA. Requires a live signature proving wallet ownership (see
# /api/perps/qa-bypass) — not a plain flag, so it can't be copied from the
# client bundle by someone who doesn't hold the address's private key.
# PERPS_QA_ALLOWLIST=YourSolanaAddressHere

# Optional — Railway sets this automatically
# PORT=8787
